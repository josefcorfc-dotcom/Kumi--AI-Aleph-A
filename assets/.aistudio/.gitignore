<script>
    // Data para Evolución de Latencia (Chart.js)
    const ctx = document.getElementById('evolutionChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['v28.2 (Síncrono)', 'v28.3 (Redis Cache)', 'v28.4-DIRECT (RAM Local)'],
            datasets: [{
                label: 'Latencia Extremo a Extremo (ms)',
                data: [180, 15, 0.18],
                backgroundColor: ['#78716c', '#d4af37', '#10b981'],
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { type: 'logarithmic', grid: { color: 'rgba(0,0,0,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });

    // Cambio interactivo de Fases Envelope Encryption
    const phases = {
        pi2: {
            title: 'PI_2: KMS Síncrono Directo',
            loc: 'GCP KMS Service (External Call)',
            lat: '120 - 250 ms',
            desc: 'Cada petición entrante realiza una llamada de red síncrona hacia la API de Google Cloud KMS para desempaquetar la clave de cifrado de datos (DEK). Alta latencia e impacto por ratelimiting.',
            latClass: 'text-rose-500'
        },
        pi3: {
            title: 'PI_3: Caché Redis Distribuido',
            loc: 'Memorystore Redis Cluster',
            lat: '5 - 15 ms',
            desc: 'Las DEK se almacenan en una instancia externa de Redis. Se reduce la sobrecarga a GCP KMS, pero se mantiene la latencia de red en la red privada de GCP (VPC Connector).',
            latClass: 'text-amber-500'
        },
        pi4: {
            title: 'PI_4: Direct In-Memory Engine',
            loc: 'Cloud Run Gen2 RAM',
            lat: '< 0.2 ms',
            desc: 'La clave de cifrado de datos (DEK) se almacena en la memoria volátil del contenedor. Al recibir un mensaje de Pub/Sub, la desencripción AES-256-GCM se ejecuta instantáneamente sin salir de la instancia de cómputo.',
            latClass: 'text-emerald-600'
        }
    };

    function switchPhase(phaseKey) {
        const phase = phases[phaseKey];
        document.getElementById('phase-title').innerText = phase.title;
        document.getElementById('phase-loc').innerText = phase.loc;
        
        const latEl = document.getElementById('phase-lat');
        latEl.innerText = phase.lat;
        latEl.className = `text-sm font-bold ${phase.latClass}`;
        
        document.getElementById('phase-desc').innerText = phase.desc;

        document.querySelectorAll('.phase-btn').forEach(btn => {
            btn.classList.remove('border-amber-500', 'bg-amber-50/50');
        });
        document.getElementById(`btn-${phaseKey}`).classList.add('border-amber-500', 'bg-amber-50/50');
    }

    // Generador fractal del Conjunto de Cantor
    function renderCantor() {
        const canvas = document.getElementById('cantorCanvas');
        const ctx = canvas.getContext('2d');
        const depth = parseInt(document.getElementById('cantor-depth').value);
        document.getElementById('depth-val').innerText = depth;

        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const width = canvas.width - 40;
        const startX = 20;
        const startY = 20;
        const lineHeight = 12;
        const gap = 18;

        function drawCantorLine(x, y, len, currentDepth) {
            if (currentDepth > depth) return;

            ctx.fillStyle = '#d4af37';
            ctx.fillRect(x, y, len, lineHeight);

            const newLen = len / 3;
            const nextY = y + gap;

            drawCantorLine(x, nextY, newLen, currentDepth + 1);
            drawCantorLine(x + newLen * 2, nextY, newLen, currentDepth + 1);
        }

        drawCantorLine(startX, startY, width, 1);
    }

    // Inicializar render inicial
    window.onload = () => {
        renderCantor();
    };
</script>



